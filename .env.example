# ============================================
# 企业级 RAG + Agent 系统 — 环境变量模板
# 复制为 .env 文件并填入真实值
# ============================================

# DeepSeek API（LLM 调用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Qdrant 向量数据库
QDRANT_URL=https://your-instance.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Langfuse 可观测性（可选，不配则不启用）
LANGFUSE_PUBLIC_KEY=pk-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# BGE Embedding / Reranker 模型（可选，默认 HuggingFace）
BGE_EMBEDDING_MODEL=BAAI/bge-m3
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu

# Pipeline 参数
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5

# 反思评估参数
REFLECTION_THRESHOLD=7
REFLECTION_MAX_RETRIES=3

# Agent 参数
AGENT_MAX_ITERATIONS=5

# Redis 多轮对话记忆（可选，不配则降级为单轮）
REDIS_URL=redis://localhost:6379
SESSION_TTL=3600
MAX_MESSAGES=20
